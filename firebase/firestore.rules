rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/Admin/$(request.auth.uid));
    }

    function requestOwnsDocument() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsDocumentOrIsAdmin() {
      return ownsDocument() || isAdmin();
    }

    function preservesOwnership() {
      return signedIn() && request.resource.data.userId == resource.data.userId;
    }

    // members own their profile but cannot give themselves a role or switch a deactivated
    // account back on. Only an admin deletes a profile, otherwise a deactivated member could
    // delete it and create a fresh active one.
    match /UserProfile/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.role == 'member'
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 60;
      allow update: if signedIn()
        && (isAdmin()
          || (request.auth.uid == userId
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('active', true) == resource.data.get('active', true)
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 60));
      allow delete: if isAdmin();
    }

    function validMoodEntry(data) {
      return data.keys().hasOnly(['userId', 'moodLevel', 'note', 'createdAt'])
        && data.keys().hasAll(['userId', 'moodLevel', 'note', 'createdAt'])
        && data.userId is string
        && data.moodLevel is int
        && data.moodLevel >= 1
        && data.moodLevel <= 5
        && data.note is string
        && data.note.size() <= 500
        && data.createdAt is timestamp;
    }

    match /MoodEntry/{entryId} {
      allow create: if requestOwnsDocument()
        && validMoodEntry(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow read, delete: if ownsDocument();
      allow update: if ownsDocument()
        && preservesOwnership()
        && validMoodEntry(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Private journal. The brief sets this boundary: entries belong to the member who wrote
    // them, and the practice sees streaks and points through SucculentState but never the
    // writing itself (IIE, 2026, WIL-37, WIL-38 and WIL-44). Hence no isAdmin() clause here.
    // Allowed fields and types are checked with keys().hasOnly() (Firebase, n.d.).
    function validJournalEntry(data) {
      return data.keys().hasOnly(['userId', 'content', 'prompt', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['userId', 'content', 'prompt', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 10000
        && data.prompt is string
        && data.prompt.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /JournalEntry/{entryId} {
      // Timestamps must come from the server clock: request.time (Firebase, n.d.).
      // Reads only pass for queries filtered on the member's own uid (Firebase, n.d.).
      allow create: if requestOwnsDocument()
        && validJournalEntry(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read, delete: if ownsDocument();
      allow update: if ownsDocument()
        && preservesOwnership()
        && validJournalEntry(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /SucculentState/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /SucculentPointAward/{awardId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /AudioContent/{audioId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Therapist broadcasts, the podcast-style recordings. Anyone may read the schedule, which
    // is what lets the app show what is coming up, but only the practice may upload,
    // reschedule or delete one.
    function validBroadcast(data) {
      return data.keys().hasOnly(['broadcastId', 'title', 'message', 'author', 'publishedAt', 'storagePath', 'durationSeconds', 'createdAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.message is string
        && data.message.size() <= 2000
        && data.author is string
        && data.author.size() <= 120
        && data.publishedAt is timestamp
        && data.storagePath is string
        && data.durationSeconds is int
        && data.durationSeconds >= 0;
    }

    match /Broadcast/{broadcastId} {
      allow read: if true;
      allow create, update: if isAdmin() && validBroadcast(request.resource.data);
      allow delete: if isAdmin();
    }

    match /DailyBroadcast/{broadcastId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /relaxationTracks/{trackId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /Admin/{adminId} {
      allow read: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // Kept to the same 200 characters the admin screen allows, so an older app build or any other
    // client can't slip a too-long line past it (the Firebase console itself bypasses rules)
    function validAffirmation(data) {
      return data.text is string
        && data.text.trim().size() > 0
        && data.text.size() <= 200;
    }

    match /Affirmation/{affirmationId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && validAffirmation(request.resource.data);
      allow delete: if isAdmin();
    }

    match /AudioSession/{sessionId} {
      allow create: if requestOwnsDocument();
      allow read, delete: if ownsDocumentOrIsAdmin();
      allow update: if ownsDocumentOrIsAdmin()
        && (isAdmin()
          || (preservesOwnership()
            && request.resource.data.get("pointsAwarded", false)
              == resource.data.get("pointsAwarded", false)));
    }

    match /MeditationCategory/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /Quiz/{quizId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /quizQuestions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Only calculateQuizRecommendation writes results, so a client can't fake a score
    match /quizResults/{resultId} {
      allow read, delete: if ownsDocument();
      allow create, update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Reference List
// Firebase, 2026. Get started with Firebase Security Rules (Cloud Storage for Firebase). [online] Available at: <https://firebase.google.com/docs/storage/security/get-started> [Accessed 2 October 2026].
// Firebase, n.d. Control access to specific fields. [online] Available at: <https://firebase.google.com/docs/firestore/security/rules-fields> [Accessed 21 September 2026].
// Firebase, n.d. Securely query data. [online] Available at: <https://firebase.google.com/docs/firestore/security/rules-query> [Accessed 21 September 2026].
// Firebase, n.d. Writing conditions for Cloud Firestore Security Rules. [online] Available at: <https://firebase.google.com/docs/firestore/security/rules-conditions> [Accessed 21 September 2026].
