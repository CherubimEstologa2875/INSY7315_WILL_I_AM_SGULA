<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingTop="@dimen/sgula_space_5"
    android:paddingBottom="@dimen/sgula_space_6"
    tools:ignore="HardcodedText">

    <!-- Upload and schedule a broadcast. Cards and the progress bar come from Material Components for Android (Material Components for Android, n.d.). -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sgula_space_5"
        android:paddingEnd="@dimen/sgula_space_5">

        <TextView
            style="@style/Widget.Sgula.Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin broadcasts" />

        <TextView
            style="@style/Widget.Sgula.Text.PageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload a recording and set the date and time it should reach clients. Clients see it listed as coming up until then." />

        <!-- 1. The recording -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Recording" />

                <TextView
                    android:id="@+id/admin_broadcast_file_name"
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    android:text="No recording selected" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/admin_broadcast_choose_file"
                    style="@style/Widget.Sgula.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    android:text="Choose recording" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. What the broadcast is about -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Details" />

                <com.example.insy7315_wil_.ui.widget.SgulaTextFieldView
                    android:id="@+id/admin_broadcast_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    app:sgulaLabel="Title"
                    app:sgulaPlaceholder="Managing anxiety" />

                <com.example.insy7315_wil_.ui.widget.SgulaTextFieldView
                    android:id="@+id/admin_broadcast_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    app:sgulaHelperText="Shown to clients under the title. Defaults to your name."
                    app:sgulaLabel="Recorded by"
                    app:sgulaPlaceholder="Anat Casey" />

                <com.example.insy7315_wil_.ui.widget.SgulaTextFieldView
                    android:id="@+id/admin_broadcast_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    app:sgulaFieldMinHeight="@dimen/sgula_text_area_min_height"
                    app:sgulaLabel="Description"
                    app:sgulaPlaceholder="What this morning's recording covers."
                    app:sgulaSingleLine="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. When it goes live -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Schedule" />

                <TextView
                    android:id="@+id/admin_broadcast_schedule_value"
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    tools:text="Fri 3 Oct at 07:00" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/admin_broadcast_pick_date"
                        style="@style/Widget.Sgula.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Date" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/admin_broadcast_pick_time"
                        style="@style/Widget.Sgula.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sgula_space_3"
                        android:layout_weight="1"
                        android:text="Time" />
                </LinearLayout>

                <TextView
                    android:id="@+id/admin_broadcast_schedule_note"
                    style="@style/Widget.Sgula.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    android:text="Leave it as now to publish straight away." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/admin_broadcast_upload"
            style="@style/Widget.Sgula.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4"
            android:text="Schedule broadcast" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/admin_broadcast_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_3"
            android:visibility="gone"
            app:indicatorColor="@color/sgula_primary"
            app:trackColor="@color/sgula_primary_soft"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/admin_broadcast_status"
            style="@style/Widget.Sgula.Text.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_2"
            android:visibility="gone"
            tools:text="Uploading 40%"
            tools:visibility="visible" />

        <TextView
            style="@style/Widget.Sgula.Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_5"
            android:text="Scheduled and published" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/admin_broadcast_list_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_2"
            android:indeterminate="true"
            app:indicatorColor="@color/sgula_primary"
            app:trackColor="@color/sgula_primary_soft" />

        <TextView
            android:id="@+id/admin_broadcast_list_empty"
            style="@style/Widget.Sgula.Text.CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_2"
            android:visibility="gone"
            tools:text="No broadcasts yet."
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/admin_broadcast_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
