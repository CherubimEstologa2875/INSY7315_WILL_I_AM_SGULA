<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingTop="@dimen/sgula_space_5"
    android:paddingBottom="@dimen/sgula_space_6"
    tools:ignore="HardcodedText">

    <!-- Today's broadcast. The cards come from Material Components for Android (Material Components for Android, n.d.). -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/broadcast_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sgula_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Widget.Sgula.Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily broadcast" />

        <TextView
            style="@style/Widget.Sgula.Text.PageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A short recording from your therapist, every morning." />

        <ProgressBar
            android:id="@+id/broadcast_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sgula_space_5"
            android:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/broadcast_card"
            style="@style/Widget.Sgula.Card.Raised"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_5"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/broadcast_date"
                    style="@style/Widget.Sgula.Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="5 August" />

                <TextView
                    android:id="@+id/broadcast_topic"
                    style="@style/Widget.Sgula.Text.H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    android:text="Managing Anxiety" />

                <TextView
                    android:id="@+id/broadcast_author"
                    style="@style/Widget.Sgula.Text.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_1"
                    android:textColor="@color/sgula_text_tertiary"
                    tools:text="Anat Casey" />

                <TextView
                    android:id="@+id/broadcast_description"
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_4"
                    tools:text="Anxiety tends to speak in absolutes. This morning we look at how to catch that voice early." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/broadcast_play"
                    style="@style/Widget.Sgula.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_5"
                    android:text="Play broadcast" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scheduled recording: shown with its date, not playable until it goes live -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/broadcast_upcoming_card"
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/broadcast_upcoming_date"
                    style="@style/Widget.Sgula.Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Coming Fri 3 Oct at 07:00" />

                <TextView
                    android:id="@+id/broadcast_upcoming_topic"
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_2"
                    tools:text="Sleeping Through Worry" />

                <TextView
                    android:id="@+id/broadcast_upcoming_description"
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_1"
                    tools:text="Winding the body down when the mind will not." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/broadcast_empty_text"
            style="@style/Widget.Sgula.Text.CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4"
            android:visibility="gone"
            tools:text="No broadcast has been published yet."
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/broadcast_history"
            style="@style/Widget.Sgula.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4"
            android:text="Past broadcasts" />

        <TextView
            android:id="@+id/broadcast_error_text"
            style="@style/Widget.Sgula.Text.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_2"
            android:textColor="@color/sgula_danger"
            android:visibility="gone"
            tools:text="We couldn't load today's broadcast. Check your internet connection and try again."
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
<!-- Reference List
Material Components for Android, n.d. Cards. [online] Available at: <https://github.com/material-components/material-components-android/blob/master/docs/components/Card.md> [Accessed 2 October 2026].
-->
