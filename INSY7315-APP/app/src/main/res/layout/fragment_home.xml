<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingTop="@dimen/sgula_space_5"
    android:paddingBottom="@dimen/sgula_space_6"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/home_greeting"
            style="@style/Widget.Sgula.Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Good morning" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_plant_card"
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_5"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sgula.Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your succulent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/sgula_plant_scene_sm"
                        android:layout_height="@dimen/sgula_plant_scene_sm"
                        android:background="@drawable/sgula_plant_scene_bg">

                        <ImageView
                            android:id="@+id/home_plant_icon"
                            android:layout_width="@dimen/sgula_plant_hero_sm"
                            android:layout_height="@dimen/sgula_plant_hero_sm"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_plant_seed" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sgula_space_4"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/home_plant_stage_name"
                            style="@style/Widget.Sgula.Text.PlantStageName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Seed" />

                        <TextView
                            android:id="@+id/home_plant_points_caption"
                            style="@style/Widget.Sgula.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sgula_space_1"
                            android:text="0 pts, 100 more to reach Sprout" />

                        <ProgressBar
                            android:id="@+id/home_plant_progress"
                            style="@style/Widget.Sgula.GrowBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sgula_space_3"
                            android:progress="0" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.example.insy7315_wil_.ui.widget.AffirmationCardView
            android:id="@+id/home_affirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_5"
            app:sgulaAffirmation="&quot;I am allowed to grow at my own pace.&quot;" />

        <TextView
            style="@style/Widget.Sgula.Text.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_5"
            android:text="Quick actions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_tile_mood"
                style="@style/Widget.Sgula.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/sgula_space_3"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:contentPadding="@dimen/sgula_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/sgula_tile_icon_badge"
                        android:layout_height="@dimen/sgula_tile_icon_badge"
                        android:background="@drawable/sgula_chip_accent_soft">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tile_mood"
                            app:tint="@color/sgula_plum_600" />
                    </FrameLayout>

                    <TextView
                        style="@style/Widget.Sgula.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sgula_space_2"
                        android:text="Log mood" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_tile_journal"
                style="@style/Widget.Sgula.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:contentPadding="@dimen/sgula_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/sgula_tile_icon_badge"
                        android:layout_height="@dimen/sgula_tile_icon_badge"
                        android:background="@drawable/sgula_chip_accent_soft">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tile_journal"
                            app:tint="@color/sgula_plum_600" />
                    </FrameLayout>

                    <TextView
                        style="@style/Widget.Sgula.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sgula_space_2"
                        android:text="Journal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_3"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_tile_audio"
                style="@style/Widget.Sgula.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/sgula_space_3"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:contentPadding="@dimen/sgula_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/sgula_tile_icon_badge"
                        android:layout_height="@dimen/sgula_tile_icon_badge"
                        android:background="@drawable/sgula_chip_accent_soft">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tile_audio"
                            app:tint="@color/sgula_plum_600" />
                    </FrameLayout>

                    <TextView
                        style="@style/Widget.Sgula.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sgula_space_2"
                        android:text="Audio" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_tile_quiz"
                style="@style/Widget.Sgula.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:contentPadding="@dimen/sgula_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/sgula_tile_icon_badge"
                        android:layout_height="@dimen/sgula_tile_icon_badge"
                        android:background="@drawable/sgula_chip_accent_soft">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tile_quiz"
                            app:tint="@color/sgula_plum_600" />
                    </FrameLayout>

                    <TextView
                        style="@style/Widget.Sgula.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sgula_space_2"
                        android:text="Quiz" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_play_broadcast"
            style="@style/Widget.Sgula.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_6"
            android:text="Play today's broadcast" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
