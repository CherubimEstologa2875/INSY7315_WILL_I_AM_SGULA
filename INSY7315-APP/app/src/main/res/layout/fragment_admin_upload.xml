<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingTop="@dimen/sgula_space_5"
    android:paddingBottom="@dimen/sgula_space_6"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Sgula.Text.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin upload audio" />

        <TextView
            style="@style/Widget.Sgula.Text.PageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add a new audio file and assign it to a wellness category."            />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. File picker" />

                <TextView
                    style="@style/Widget.Sgula.Text.CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose the meditation audio file to upload." />

                <TextView
                    android:id="@+id/admin_upload_file_name"
                    style="@style/Widget.Sgula.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    android:text="No file selected" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/admin_upload_choose_file"
                    style="@style/Widget.Sgula.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_3"
                    android:text="Choose file" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sgula.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Sgula.Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Broadcast details" />

                <com.example.insy7315_wil_.ui.widget.SgulaTextFieldView
                    android:id="@+id/admin_upload_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:sgulaLabel="Title"
                    app:sgulaPlaceholder="Calm reset session" />

                <com.example.insy7315_wil_.ui.widget.SgulaDropdownFieldView
                    android:id="@+id/admin_upload_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_4"
                    app:sgulaLabel="Library tab"
                    app:sgulaEntries="@array/sgula_audio_tabs"
                    app:sgulaSelection="Guided meditation" />

                <com.example.insy7315_wil_.ui.widget.SgulaDropdownFieldView
                    android:id="@+id/admin_upload_wellness_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sgula_space_4"
                    app:sgulaLabel="Wellness category"
                    app:sgulaSelection="Loading categories..." />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/admin_upload_broadcast_date_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Broadcast date">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/admin_upload_broadcast_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/admin_upload_button"
            style="@style/Widget.Sgula.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_5"
            android:text="Upload audio" />

        <TextView
            style="@style/Widget.Sgula.Text.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_6"
            android:text="Uploaded audio" />

        <ProgressBar
            android:id="@+id/admin_audio_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sgula_space_3"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/admin_audio_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_3"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/admin_audio_empty"
            style="@style/Widget.Sgula.Text.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sgula_space_2"
            android:text="No audio has been uploaded yet."
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
